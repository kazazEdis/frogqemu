+static void rtl_reset_state(RTL8188EUState *s)
+{
+    RxFrame *f;
+
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->rf, 0, sizeof(s->rf));
+    /* SYS_CFG: normal chip, UMC vendor, cut C */
+    rtl_reg_set(s, REG_SYS_CFG, 4, (1u << 19) | (2u << 12));
+    s->txlen[0] = s->txlen[1] = 0;
+    while ((f = QSIMPLEQ_FIRST(&s->rxq))) {
+        QSIMPLEQ_REMOVE_HEAD(&s->rxq, next);
+        g_free(f);
+    }
+    s->rxq_len = 0;
+    g_free(s->rx_cur);
+    s->rx_cur = NULL;
+    s->rx_pending = NULL;
+    s->state = STA_IDLE;
+    s->keyed = false;
+    s->seq = 0;
+    s->retries = 0;
+    if (s->timer) {
+        timer_del(s->timer);
+    }
+}
