+/* ---- Realtek MAC registers (subset) ------------------------------------ */
+#define REG_SYS_FUNC_EN         0x0002
+#define REG_APS_FSMCO           0x0004
+#define REG_9346CR              0x000A
+#define REG_RSV_CTRL            0x001C
+#define REG_EFUSE_CTRL          0x0030
+#define REG_MCUFWDL             0x0080
+#define REG_SYS_CFG             0x00F0
+#define REG_HMEBOX_E0           0x0088      /* IOL control (8051 offload) */
+#define REG_CR                  0x0100
+#define REG_PKT_BUFF_ACCESS_CTRL 0x0106
+#define REG_PKTBUF_DBG_ADDR     0x0140
+#define REG_TXPKTBUF_DBG        0x0143
+#define REG_PKTBUF_DBG_DATA_L   0x0144
+#define REG_HMETFR              0x01CC
+#define REG_LLT_INIT            0x01E0
+#define REG_TDECTRL             0x0208
+#define REG_MACID               0x0610
+#define REG_BSSID               0x0618
+#define REG_CAMCMD              0x0670
+#define REG_CAMWRITE            0x0674
+#define REG_CAMREAD             0x0678
+
+#define MCUFWDL_EN              BIT(0)
+#define MCUFWDL_RDY             BIT(1)
+#define FWDL_CHKSUM_RPT         BIT(2)
+#define WINTINI_RDY             BIT(6)
+#define RAM_DL_SEL              BIT(7)
+
+#define BOOT_FROM_EEPROM        BIT(4)
+#define EEPROM_EN               BIT(5)
+
+/* BB registers used by the RF serial interface (path A) */
+#define RFPGA0_XA_HSSIPARAMETER2 0x0824
+#define RFPGA0_XA_LSSIPARAMETER  0x0840
+#define RFPGA0_XA_LSSIREADBACK   0x08A0
+#define TRANSCEIVEA_HSPI_READBACK 0x08B8
+#define LSSI_READ_EDGE          BIT(31)
+
+#define FW_START_ADDRESS        0x1000
+#define FW_PAGE_SIZE            0x1000
+#define FW_PAGES                8
+
+/* IOL: commands the driver hands to the 8051 through the beacon queue */
+#define CMD_INIT_LLT            BIT(0)
+#define CMD_READ_EFUSE_MAP      BIT(1)
+#define CMD_EFUSE_PATCH         BIT(2)
+#define CMD_IOCONFIG            BIT(3)
+#define IOREG_CMD_WB_REG        0x04
+#define IOREG_CMD_WW_REG        0x05
+#define IOREG_CMD_WD_REG        0x06
+#define IOREG_CMD_W_RF          0x07
+#define IOREG_CMD_END           0xFF
+#define TXPKT_BUF_SELECT        0x69
+
+#define EFUSE_PHYS_LEN          512
+#define EFUSE_MAP_LEN           512
+
+#define TXDESC_SIZE             32
+#define RXDESC_SIZE             24
+
+/* ---- 802.11 ------------------------------------------------------------ */
+#define FC_TYPE_MGMT            0
+#define FC_TYPE_DATA            2
+#define FC_PROTECTED            0x4000
+#define FC_TODS                 0x0100
+#define FC_FROMDS               0x0200
+#define ST_ASSOC_REQ            0
+#define ST_ASSOC_RESP           1
+#define ST_PROBE_RESP           5
+#define ST_BEACON               8
+#define ST_DISASSOC             10
+#define ST_AUTH                 11
+#define ST_DEAUTH               12
+#define ST_DATA_NULL            4
+#define IE_SSID                 0
+#define IE_RATES                1
+#define IE_DS_PARAM             3
+#define IE_RSN                  48
+#define IE_EXT_RATES            50
+#define ETH_P_EAPOL             0x888e
+#define ETH_P_ARP               0x0806
+#define CCMP_HDR_LEN            8
+#define CCMP_MIC_LEN            8
+
+typedef enum {
+    STA_IDLE,        /* nothing heard from the AP yet */
+    STA_AUTH,        /* auth request sent */
+    STA_ASSOC,       /* assoc request sent */
+    STA_HANDSHAKE,   /* associated, waiting for EAPOL msg 1/3 */
+    STA_CONNECTED,   /* keys (if any) installed, bridging */
+} StaState;
+
+typedef struct RxFrame {
+    QSIMPLEQ_ENTRY(RxFrame) next;
+    uint32_t len;
+    uint8_t data[];
+} RxFrame;
+
+struct RTL8188EUState {
+    USBDevice dev;
+    NICConf conf;
+    NICState *nic;
+    char *psk;
+    uint32_t trace;
+
+    /* register file and memories */
+    uint8_t regs[0x10000];
+    uint8_t fwmem[FW_PAGES * FW_PAGE_SIZE];
+    uint8_t efuse[EFUSE_PHYS_LEN];
+    uint32_t rf[0x100];
+    /* beacon-queue payload (beacon or IOL command list) and the "reserved
+     * page" image the 8051 exposes through the txpktbuf debug port */
+    uint8_t bcn_buf[4096];
+    uint32_t bcn_len;
+    uint8_t iol_page[2 + EFUSE_PHYS_LEN];
+    uint32_t iol_bcnhead;
+
+    /* USB transfer state */
+    uint8_t txbuf[2][16384];
+    uint32_t txlen[2];
+    QSIMPLEQ_HEAD(, RxFrame) rxq;
+    uint32_t rxq_len;
+    RxFrame *rx_cur;
+    uint32_t rx_pos;
+    USBPacket *rx_pending;
+    bool tx_enabled;
+
+    /* virtual station */
+    StaState state;
+    uint8_t bssid[6];
+    uint8_t sta_mac[6];
+    uint8_t dev_mac[6];         /* the adapter's own (EFUSE) MAC = AP BSSID */
+    uint8_t peer_mac[6];
+    bool peer_known;
+    char ssid[33];
+    uint8_t ssid_len;
+    uint8_t ap_rsn[64];
+    uint8_t ap_rsn_len;
+    bool rsn;
+    bool keyed;
+    uint16_t seq;
+    uint16_t aid;
+    uint8_t anonce[32], snonce[32];
+    uint8_t pmk[32], ptk[64];
+    bool pmk_valid;
+    uint64_t replay;
+    QEMUTimer *timer;
+    int retries;
+    int64_t last_data_ns;
+
+    /* DHCP client: the dongle only treats a station as a "phone" once it
+     * holds a lease, so the station asks for one like a real client */
+    uint32_t dhcp_xid;
+    uint32_t lease_ip;          /* network byte order, 0 = none */
+    uint32_t dhcp_server;
+    int dhcp_tries;
+    uint32_t peer_ip;           /* last IPv4 source seen from the netdev */
+    int64_t peer_ann_ns;
+};
