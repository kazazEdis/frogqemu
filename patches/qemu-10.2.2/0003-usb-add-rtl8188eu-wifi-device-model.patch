+static void rtl_handle_reset(USBDevice *dev)
+{
+    RTL8188EUState *s = USB_RTL8188EU(dev);
+
+    RTL_LOG(s, 1, "usb reset\n");
+    rtl_reset_state(s);
+}
+
+static void rtl_handle_control(USBDevice *dev, USBPacket *p, int request,
+                               int value, int index, int length, uint8_t *data)
+{
+    RTL8188EUState *s = USB_RTL8188EU(dev);
+    int ret;
+
+    ret = usb_desc_handle_control(dev, p, request, value, index, length, data);
+    if (ret >= 0) {
+        return;
+    }
+
+    switch (request) {
+    case VendorDeviceOutRequest | 0x05:
+        if (length > 254) {
+            goto fail;
+        }
+        rtl_write_reg(s, value & 0xffff, data, length);
+        RTL_LOG(s, 2, "reg write 0x%04x len %d = 0x%08x\n", value, length,
+                length <= 4 ? rtl_reg_get(s, value, length) : 0);
+        p->actual_length = length;
+        return;
+    case VendorDeviceRequest | 0x05:
+        if (length > 254) {
+            goto fail;
+        }
+        rtl_read_reg(s, value & 0xffff, data, length);
+        RTL_LOG(s, 2, "reg read  0x%04x len %d = 0x%08x\n", value, length,
+                length <= 4 ? (uint32_t)(length == 1 ? data[0] :
+                              length == 2 ? lduw_le_p(data) : ldl_le_p(data))
+                            : 0);
+        p->actual_length = length;
+        return;
+    default:
+        break;
+    }
+fail:
+    RTL_LOG(s, 1, "unhandled control request 0x%x value 0x%x index 0x%x len %d\n",
+            request, value, index, length);
+    p->status = USB_RET_STALL;
+}
+
+static void rtl_handle_data(USBDevice *dev, USBPacket *p)
+{
+    RTL8188EUState *s = USB_RTL8188EU(dev);
+    int ep = p->ep->nr;
+
+    if (p->pid == USB_TOKEN_OUT && (ep == 2 || ep == 3)) {
+        int idx = ep - 2;
+        uint32_t room = sizeof(s->txbuf[idx]) - s->txlen[idx];
+        uint32_t n = MIN(p->iov.size, room);
+
+        usb_packet_copy(p, s->txbuf[idx] + s->txlen[idx], n);
+        s->txlen[idx] += n;
+        RTL_LOG(s, 2, "bulk out ep%d packet %zu bytes (buffered %u)\n", ep,
+                p->iov.size, s->txlen[idx]);
+        rtl_tx_drain(s, idx);
+        if (s->txlen[idx] >= sizeof(s->txbuf[idx])) {
+            s->txlen[idx] = 0;                  /* overrun: resynchronise */
+        }
+        return;
+    }
+    if (p->pid == USB_TOKEN_IN && ep == 1) {
+        if (s->rx_pending) {
+            RTL_LOG(s, 1, "second bulk-in while one is pending\n");
+            p->status = USB_RET_NAK;
+            return;
+        }
+        if (rtl_rx_fill(s, p)) {
+            return;                             /* data available now */
+        }
+        s->rx_pending = p;                      /* completes when data arrives */
+        p->status = USB_RET_ASYNC;
+        return;
+    }
+    if (p->pid == USB_TOKEN_IN && ep == 4) {
+        p->status = USB_RET_NAK;
+        return;
+    }
+    p->status = USB_RET_STALL;
+}
+
+static void rtl_cancel_packet(USBDevice *dev, USBPacket *p)
+{
+    RTL8188EUState *s = USB_RTL8188EU(dev);
+
+    if (s->rx_pending == p) {
+        s->rx_pending = NULL;
+    }
+}
+
+static void rtl_realize(USBDevice *dev, Error **errp)
+{
+    RTL8188EUState *s = USB_RTL8188EU(dev);
+    const char *t = getenv("RTL8188EU_TRACE");
+
+    s->trace = t ? atoi(t) : 1;
+    usb_desc_create_serial(dev);
+    usb_desc_init(dev);
+    qemu_macaddr_default_if_unset(&s->conf.macaddr);
+    /* the station (netdev side) uses the NIC MAC; the adapter's own MAC
+     * (Realtek OUI, last two octets from the NIC MAC so the SSID suffix the
+     * firmware derives from it stays recognisable) must differ from it */
+    memcpy(s->sta_mac, s->conf.macaddr.a, 6);
+    memcpy(s->dev_mac, "\x00\xe0\x4c\xa1", 4);
+    s->dev_mac[4] = s->conf.macaddr.a[4];
+    s->dev_mac[5] = s->conf.macaddr.a[5];
+    if (!s->psk) {
+        s->psk = g_strdup("12345678");
+    }
+    QSIMPLEQ_INIT(&s->rxq);
+    rtl_build_efuse(s);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, rtl_sta_timer, s);
+    rtl_reset_state(s);
+    s->nic = qemu_new_nic(&net_rtl8188eu_info, &s->conf,
+                          object_get_typename(OBJECT(s)), dev->qdev.id,
+                          &dev->qdev.mem_reentrancy_guard, s);
+    qemu_format_nic_info_str(qemu_get_queue(s->nic), s->conf.macaddr.a);
+    RTL_LOG(s, 1, "realized, station mac %02x:%02x:%02x:%02x:%02x:%02x psk '%s'\n",
+            s->sta_mac[0], s->sta_mac[1], s->sta_mac[2], s->sta_mac[3],
+            s->sta_mac[4], s->sta_mac[5], s->psk);
+}
+
+static void rtl_unrealize(USBDevice *dev)
+{
+    RTL8188EUState *s = USB_RTL8188EU(dev);
+
+    timer_free(s->timer);
+    s->timer = NULL;
+    qemu_del_nic(s->nic);
+}
+
+static const Property rtl8188eu_properties[] = {
+    DEFINE_NIC_PROPERTIES(RTL8188EUState, conf),
+    DEFINE_PROP_STRING("psk", RTL8188EUState, psk),
+};
+
+static void rtl8188eu_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    USBDeviceClass *uc = USB_DEVICE_CLASS(klass);
+
+    uc->realize        = rtl_realize;
+    uc->unrealize      = rtl_unrealize;
+    uc->product_desc   = "Realtek RTL8188EU 802.11n USB adapter";
+    uc->usb_desc       = &desc_rtl8188eu;
+    uc->handle_reset   = rtl_handle_reset;
+    uc->handle_control = rtl_handle_control;
+    uc->handle_data    = rtl_handle_data;
+    uc->cancel_packet  = rtl_cancel_packet;
+    set_bit(DEVICE_CATEGORY_NETWORK, dc->categories);
+    dc->fw_name = "network";
+    device_class_set_props(dc, rtl8188eu_properties);
+}
+
+static const TypeInfo rtl8188eu_info = {
+    .name          = TYPE_USB_RTL8188EU,
+    .parent        = TYPE_USB_DEVICE,
+    .instance_size = sizeof(RTL8188EUState),
+    .class_init    = rtl8188eu_class_init,
+};
+
+static void rtl8188eu_register_types(void)
+{
+    type_register_static(&rtl8188eu_info);
+}
+
+type_init(rtl8188eu_register_types)
